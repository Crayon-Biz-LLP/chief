{
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "runtime": "python3.12"
        }
    },
    "crons": [
        {
            "path": "/api/pulse",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/research",
            "schedule": "*/15 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.py"
        }
    ]
}